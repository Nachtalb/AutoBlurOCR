{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoBlur",
  "version": "0.6.1",
  "identifier": "app.autoblur.redact",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AutoBlur — OCR redaction",
        "width": 1680,
        "height": 980,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi"
      }
    }
  }
}
